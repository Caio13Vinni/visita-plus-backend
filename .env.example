# =============================================================================
# VISITA+ — Variáveis de ambiente (nunca commitar valores reais)
# =============================================================================

# --- API ---
API_HOST=0.0.0.0
API_PORTA=8080
RUST_LOG=info

# --- Credenciais do Banco Central (PostgreSQL) ---
POSTGRES_SERVIDOR=localhost
POSTGRES_PORTA=5432
POSTGRES_USUARIO=visita
POSTGRES_SENHA=visita_forte_2026
POSTGRES_BANCO=visita_plus
DATABASE_URL=postgres://visita:visita_forte_2026@localhost:5432/visita_plus

# --- Banco Local (SQLite — simulacao mobile) ---
SQLITE_ENDERECO=/dados/visita_plus_local.db

# --- Seguranca (gerar valores fortes em producao) ---
JWT_SEGREDO=troque_este_segredo_em_producao_1234567890
JWT_EXPIRACAO_MINUTOS=1440

# --- Primeira conta Coordenador (seed de desenvolvimento) ---
SEED_COORDENADOR_NOME=Coordenador Demonstracao
SEED_COORDENADOR_EMAIL=coordenador@visitaplus.test
SEED_COORDENADOR_SENHA=Mudar#2026